{
  "name": "lattice-swap-web",
  "version": "0.1.0",
  "description": "The browser buyer UI for NEX<->BTC atomic swaps",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wasm": "vendor/lattice-swap/web/driver/build.sh",
    "dev": "vite",
    "build": "vite build",
    "build:signet": "vite build --mode signet --outDir dist-signet",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@preact/preset-vite": "2.10.2",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.15.30",
    "eslint": "9.29.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "1.4.4"
  }
}
