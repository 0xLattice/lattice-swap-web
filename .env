# Mainnet, the default build. VITE_RELAY is the swap relay whose offers the
# page lists; empty, the page says no relay is configured. Set any of these
# in the environment to override them at build time.
VITE_NETWORK=bitcoin
VITE_ESPLORA=https://mempool.space/api
VITE_NEXUS=https://lattice-mainnet-read.fly.dev
VITE_RELAY=https://lattice-swap-relay.fly.dev
# The relay directory more relays are read from: a node hosting its chain,
# and the chain's path. No node is set, so none is read: the chain is filled
# in for a buyer who sets a node.
VITE_RELAY_DIRECTORY=
VITE_RELAY_DIRECTORY_CHAIN=Nexus/swap-relays
