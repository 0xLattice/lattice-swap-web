# The live test: Bitcoin signet against Nexus. `npm run build:signet`.
VITE_NETWORK=signet
VITE_ESPLORA=https://mempool.space/signet/api
VITE_NEXUS=https://lattice-mainnet-read.fly.dev
VITE_RELAY=
# No public node is known to host the test relay directory: its chain is
# filled in for a buyer who sets a node of their own.
VITE_RELAY_DIRECTORY=
VITE_RELAY_DIRECTORY_CHAIN=Nexus/testnet/swap-relays
# Shallow test terms, so a live run takes about an hour and a half, not a
# day: the seller offers them with `lattice-swap offer --btc-confirmations 1
# --nex-confirmations 2 --t1 72 --t2 36`. Mainnet (.env) keeps the CLI's
# defaults: 6 and 12 confirmations, t1 288, t2 144.
VITE_BOUNDS={"min_btc_confirmations":1,"min_nex_confirmations":2,"min_t2":36,"min_refund_window":24}
